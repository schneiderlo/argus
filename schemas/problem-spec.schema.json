{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/problem-spec.schema.json",
  "title": "ProblemSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request",
    "constraints",
    "success_criteria",
    "context"
  ],
  "properties": {
    "request": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  }
}
