{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/candidate.schema.json",
  "title": "Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thesis",
    "mechanism",
    "assumptions",
    "strengths",
    "failure_modes",
    "unknowns",
    "implementation_shape",
    "evidence"
  ],
  "properties": {
    "thesis": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation_shape": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
